# Fill in a block below when you're ready to spend Azure / Gemini credits.

# --- Azure AI Document Intelligence (layout parsing) ---
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=

# --- Azure OpenAI (models deployed via Azure AI Foundry, chat + extraction) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini API (REQUIRED - sole embedding provider) ---
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest  # chat + extraction model (auto-updating alias); AZURE_OPENAI_CHAT_DEPLOYMENT above is now unused unless FOUNDRY_PROJECT_ENDPOINT is also set

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=paper-chunks

# --- Azure Blob Storage (optional, local disk is used if blank) ---
AZURE_STORAGE_CONN_STR=
AZURE_STORAGE_CONTAINER=papers

# --- Firebase Auth (end-user login only) ---
FIREBASE_SERVICE_ACCOUNT_PATH=
